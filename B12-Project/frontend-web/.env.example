# Copy to .env.local for local development, and set the same keys in Vercel for production.

# URL of the Node/Express API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Public URL of this web app — used for SEO metadata, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Support / privacy contact shown in the Privacy Policy
NEXT_PUBLIC_CONTACT_EMAIL=
